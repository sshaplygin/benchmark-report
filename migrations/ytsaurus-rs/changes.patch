index 0000000..e9b5dc9
--- /dev/null
+++ b/scripts/benchmark_report_inputs.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Record Criterion environment and assemble the four completed suite inputs."""
+
+import argparse
+import json
+import os
+import subprocess
+from pathlib import Path
+
+SUITES = {
+    "client": ("ytsaurus-client", "rows"),
+    "job": ("ytsaurus-job", "job_throughput"),
+    "skiff": ("ytsaurus-skiff", "codec_throughput"),
+    "yson": ("ytsaurus-yson", "yson_benchmark"),
+}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("mode", choices=("record", "assemble"))
+    parser.add_argument("--logs", type=Path)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if args.mode == "record":
+        toolchain = subprocess.check_output(["rustc", "--version"], text=True).strip()
+        Path("environment.json").write_text(
+            json.dumps(
+                {
+                    "toolchain": toolchain,
+                    "os": "linux",
+                    "arch": "amd64",
+                    "runner": "github-hosted:ubuntu-24.04",
+                }
+            )
+            + "\n"
+        )
+        return
+    if args.logs is None or args.output is None:
+        parser.error("assemble requires --logs and --output")
+    environments = []
+    suites = {"base": [], "head": []}
+    for suite, (package, bench) in SUITES.items():
+        directory = args.logs / f"criterion-main-vs-pr-{suite}"
+        environments.append(json.loads((directory / "environment.json").read_text()))
+        for side, folder in (("base", "base"), ("head", "pr")):
+            log = directory / folder / "benchmarks.txt"
+            if not log.is_file() or log.stat().st_size == 0:
+                raise ValueError(f"missing or empty suite log: {log}")
+            suites[side].append(
+                {
+                    "id": suite,
+                    "parser": {"name": "criterion", "version": "1"},
+                    "command": f"cargo bench --locked -p {package} --bench {bench} -- --noplot",
+                    "files": [str(log.resolve())],
+                }
+            )
+    if any(environment != environments[0] for environment in environments):
+        raise ValueError("suite toolchains or runner environments differ")
+    args.output.mkdir(parents=True, exist_ok=True)
+    for side, variable in (("base", "BASE_SHA"), ("head", "HEAD_SHA")):
+        manifest = {
+            "schema_version": 1,
+            "revision": os.environ[variable],
+            "environment": environments[0],
+            "expected_suites": list(SUITES),
+            "suites": suites[side],
+        }
+        (args.output / f"{side}.json").write_text(json.dumps(manifest, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sshaplygin.github.io/benchmark-report/schemas/reproduction.schema.json",
  "title": "reproduction version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "runner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolchain",
            "os",
            "arch",
            "runner"
          ]
        }
      },
      "required": [
        "revision",
        "environment"
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "runner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolchain",
            "os",
            "arch",
            "runner"
          ]
        }
      },
      "required": [
        "revision",
        "environment"
      ]
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "pattern": "^/|\\\\|^[A-Za-z]:"
                }
              },
              {
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)"
                }
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "raw",
              "manifest",
              "configuration",
              "normalized",
              "comparison",
              "markdown",
              "presentation",
              "statistics"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ]
      },
      "minItems": 1
    },
    "statistics": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "version"
                ]
              },
              "executable_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "suite": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "side": {
                      "enum": [
                        "base",
                        "head"
                      ]
                    },
                    "suite": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "side",
                    "suite",
                    "path",
                    "sha256"
                  ]
                },
                "minItems": 2
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              }
            },
            "required": [
              "tool",
              "executable_sha256",
              "suite",
              "arguments",
              "inputs",
              "stdout",
              "stderr"
            ]
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "render": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "render"
      ]
    }
  },
  "required": [
    "schema_version",
    "generator",
    "platform",
    "base",
    "head",
    "configuration_sha256",
    "files",
    "statistics",
    "replay"
  ]
}

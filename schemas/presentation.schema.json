{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sshaplygin.github.io/benchmark-report/schemas/presentation.schema.json",
  "title": "presentation version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "items": {
        "enum": [
          "benchmark",
          "base",
          "head",
          "change",
          "signal",
          "metric",
          "samples"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "enum": [
          "benchmark"
        ]
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "runner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolchain",
            "os",
            "arch",
            "runner"
          ]
        }
      },
      "required": [
        "revision",
        "environment"
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolchain": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "runner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toolchain",
            "os",
            "arch",
            "runner"
          ]
        }
      },
      "required": [
        "revision",
        "environment"
      ]
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "boolean"
        },
        "summary": {
          "type": "boolean"
        },
        "tables": {
          "type": "boolean"
        },
        "benchstat": {
          "type": "boolean"
        }
      },
      "required": [
        "metadata",
        "summary",
        "tables",
        "benchstat"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "displayed": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "regression": {
          "type": "integer",
          "minimum": 0
        },
        "improvement": {
          "type": "integer",
          "minimum": 0
        },
        "below_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "not_comparable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "selected",
        "displayed",
        "omitted",
        "regression",
        "improvement",
        "below_threshold",
        "not_comparable"
      ]
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "suite",
                    "package",
                    "metric"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "value"
              ]
            },
            "minItems": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "identity": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "suite": {
                      "type": "string",
                      "minLength": 1
                    },
                    "package": {
                      "type": "string"
                    },
                    "benchmark": {
                      "type": "string",
                      "minLength": 1
                    },
                    "metric": {
                      "enum": [
                        "time",
                        "bytes",
                        "allocations",
                        "throughput"
                      ]
                    }
                  },
                  "required": [
                    "suite",
                    "package",
                    "benchmark",
                    "metric"
                  ]
                },
                "base": {
                  "type": "string"
                },
                "head": {
                  "type": "string"
                },
                "change": {
                  "type": "string"
                },
                "signal": {
                  "enum": [
                    "regression",
                    "improvement",
                    "below_threshold",
                    "not_comparable"
                  ]
                },
                "samples": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "identity",
                "base",
                "head",
                "change",
                "signal",
                "samples"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "labels",
          "rows"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "title",
    "columns",
    "base",
    "head",
    "sections",
    "summary",
    "disclosures",
    "groups"
  ]
}
